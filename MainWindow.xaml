<Window x:Class="EveAbyssCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EVE Abyss Companion"
        Icon="pack://application:,,,/app.ico"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#FF0B0F14"
        Foreground="#FFF2F6FA">

    <Window.Resources>
        <!-- EVE-like palette -->
        <SolidColorBrush x:Key="AppBg" Color="#FF0B0F14"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#FF2A3440"/>
        <SolidColorBrush x:Key="TextMain" Color="#FFF2F6FA"/>
        <SolidColorBrush x:Key="TextDim" Color="#FFB7C3D0"/>

        <SolidColorBrush x:Key="InputText" Color="#FFF2F6FA"/>
        <SolidColorBrush x:Key="InputBg" Color="#FF0F141A"/>

        <SolidColorBrush x:Key="BtnBg" Color="#FF151B22"/>
        <SolidColorBrush x:Key="BtnBorder" Color="#FF344252"/>
        <SolidColorBrush x:Key="BtnHover" Color="#FF1E2732"/>
        <SolidColorBrush x:Key="BtnPressed" Color="#FF0E1217"/>

        <SolidColorBrush x:Key="Accent" Color="#FF33A6FF"/>
        <SolidColorBrush x:Key="Danger" Color="#FFFF5A5A"/>
        <SolidColorBrush x:Key="Success" Color="#FF4CFFB3"/>

        <LinearGradientBrush x:Key="PanelGlass" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF111A26" Offset="0"/>
            <GradientStop Color="#FF0E141E" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PanelGlassSoft" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF0F1722" Offset="0"/>
            <GradientStop Color="#FF0B1018" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TimerGlass" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF122235" Offset="0"/>
            <GradientStop Color="#FF0B141F" Offset="1"/>
        </LinearGradientBrush>

        <!-- Slightly smaller default text so more information fits on-screen -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="DimText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource InputText}"/>
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{StaticResource InputText}"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource InputText}"/>
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="OuterBorder"
                                                Background="{StaticResource InputBg}"
                                                BorderBrush="{StaticResource BtnBorder}"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M 0 0 L 8 0 L 4 5 Z"
                                                      Fill="{StaticResource TextDim}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="{StaticResource InputText}"/>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="{StaticResource InputBg}"
                                        BorderBrush="{StaticResource BtnBorder}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="320">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource InputText}"/>
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BtnHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#5533A6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Force the ComboBox popup panel background to dark -->
        <Style x:Key="DarkComboBoxToggle" TargetType="ToggleButton"/>


        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
        </Style>

        <Style x:Key="EveButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="{StaticResource BtnBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BtnHover}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource BtnPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource EveButton}"/>

        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelGlass}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style x:Key="PanelInset" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelGlassSoft}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#331E2732"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#5533A6FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#FF0F1722"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="DividerLine" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource PanelBorder}"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="Margin" Value="0,10,0,10"/>
        </Style>
    </Window.Resources>

        <Grid Background="{StaticResource AppBg}" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

<!-- ================= TOP: RUN (FULL WIDTH) ================= -->
<Border Grid.Row="0" Style="{StaticResource PanelCard}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Run" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>

        <!-- Run controls -->
        <Grid x:Name="StandardRunControls" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="200"/>  <!-- Status -->
                <ColumnDefinition Width="480" MinWidth="400"/>  <!-- Workflow -->
                <ColumnDefinition Width="*"   MinWidth="280"/>  <!-- Settings -->
            </Grid.ColumnDefinitions>

            <!-- ===== COLUMN 0: STATUS (timer + rooms) ===== -->
            <Border Grid.Column="0"
                    Background="{StaticResource TimerGlass}"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,10,0">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="TimerText" Text="20:00" FontSize="42" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="RunStateTextBlock" Text="READY" FontSize="11" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <TextBlock x:Name="RoomText" Text="Room: 0 / 3" FontSize="13" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,4,0,8"/>
                    <UniformGrid Columns="3">
                        <Button x:Name="MainR1DoneButton" Content="R1 ✓" Click="Room1Done_Click" Padding="4,6" FontSize="12"/>
                        <Button x:Name="MainR2DoneButton" Content="R2 ✓" Click="Room2Done_Click" Padding="4,6" FontSize="12"/>
                        <Button x:Name="MainR3DoneButton" Content="R3 ✓" Click="Room3Done_Click" Padding="4,6" FontSize="12"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- ===== COLUMN 1: WORKFLOW (everything you interact with, in order) ===== -->
            <Grid Grid.Column="1" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Tier label -->
                    <RowDefinition Height="Auto"/>  <!-- Tier buttons -->
                    <RowDefinition Height="Auto"/>  <!-- Weather label -->
                    <RowDefinition Height="Auto"/>  <!-- Weather buttons -->
                    <RowDefinition Height="8"/>     <!-- Spacer -->
                    <RowDefinition Height="Auto"/>  <!-- Before loot -->
                    <RowDefinition Height="Auto"/>  <!-- Start/Reset/End -->
                    <RowDefinition Height="8"/>     <!-- Spacer -->
                    <RowDefinition Height="Auto"/>  <!-- After loot + delta -->
                    <RowDefinition Height="Auto"/>  <!-- Submit -->
                </Grid.RowDefinitions>

                <!-- Tier -->
                <TextBlock Grid.Row="0" Text="Tier" Foreground="{StaticResource TextDim}" Margin="0,0,0,4"/>
                <UniformGrid x:Name="TierButtonsGrid" Grid.Row="1" Columns="7" Margin="0,0,0,8">
                    <Button Content="T0" Tag="T0 Tranquil"    Click="TierButton_Click" ToolTip="Tranquil"/>
                    <Button Content="T1" Tag="T1 Calm"        Click="TierButton_Click" ToolTip="Calm"/>
                    <Button Content="T2" Tag="T2 Agitated"    Click="TierButton_Click" ToolTip="Agitated"/>
                    <Button Content="T3" Tag="T3 Fierce"      Click="TierButton_Click" ToolTip="Fierce"/>
                    <Button Content="T4" Tag="T4 Raging"      Click="TierButton_Click" ToolTip="Raging"/>
                    <Button Content="T5" Tag="T5 Chaotic"     Click="TierButton_Click" ToolTip="Chaotic"/>
                    <Button Content="T6" Tag="T6 Cataclysmic" Click="TierButton_Click" ToolTip="Cataclysmic"/>
                </UniformGrid>

                <!-- Weather -->
                <TextBlock Grid.Row="2" Text="Weather" Foreground="{StaticResource TextDim}" Margin="0,0,0,4"/>
                <UniformGrid x:Name="WeatherButtonsGrid" Grid.Row="3" Columns="5" Margin="0,0,0,0">
                    <Button Content="⚡ Electrical" Tag="Electrical" Click="WeatherButton_Click" Padding="6,6" FontSize="12"/>
                    <Button Content="🌀 Exotic"     Tag="Exotic"     Click="WeatherButton_Click" Padding="6,6" FontSize="12"/>
                    <Button Content="🔥 Firestorm"  Tag="Firestorm"  Click="WeatherButton_Click" Padding="6,6" FontSize="12"/>
                    <Button Content="☢ Gamma"       Tag="Gamma"      Click="WeatherButton_Click" Padding="6,6" FontSize="12"/>
                    <Button Content="🌑 Dark"        Tag="Dark"       Click="WeatherButton_Click" Padding="6,6" FontSize="12"/>
                </UniformGrid>

                <!-- Before loot -->
                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Before:" Foreground="{StaticResource Accent}" FontSize="11"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="MainInvStartTextBox" Grid.Column="1" Height="22" FontSize="11"
                             BorderBrush="{StaticResource Accent}" BorderThickness="1"
                             TextChanged="MainInvStart_TextChanged"
                             PreviewTextInput="LootField_PreviewTextInput"
                             DataObject.Pasting="LootField_Pasting"
                             ToolTip="Open EVE inventory BEFORE entering the abyss — type the Est. Price value (in millions, e.g. 10.5)"/>
                </Grid>

                <!-- Start / Reset / End -->
                <UniformGrid Grid.Row="6" Columns="3" Margin="0,4,0,0">
                    <Button x:Name="StartButton" Content="▶ Start" Click="StartButton_Click" Padding="6,8" FontSize="12"/>
                    <Button x:Name="ResetButton" Content="↺ Reset" Click="ResetButton_Click" Padding="6,8" FontSize="12"/>
                    <Button x:Name="EndButton"   Content="■ End"   Click="EndButton_Click"   Padding="6,8" FontSize="12" BorderBrush="{StaticResource Danger}"/>
                </UniformGrid>

                <!-- After loot + live delta -->
                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="After:" Foreground="{StaticResource TextDim}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="MainInvEndTextBox" Grid.Column="1" Height="22" FontSize="11"
                             TextChanged="MainInvEnd_TextChanged"
                             PreviewTextInput="LootField_PreviewTextInput"
                             DataObject.Pasting="LootField_Pasting"
                             ToolTip="Open EVE inventory after looting — type the Est. Price value (in millions, e.g. 16.2)"/>
                    <TextBlock x:Name="MainLootDeltaText" Grid.Column="2" Text="" Foreground="{StaticResource Success}"
                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>

                <!-- Submit -->
                <Button x:Name="SubmitEndButton" Grid.Row="9" Content="✓ Submit &amp; End"
                        Click="LootSubmitButton_Click" Margin="0,4,0,0"
                        Padding="6,8" FontSize="12" BorderBrush="{StaticResource Success}"/>
            </Grid>

            <!-- ===== COLUMN 2: SETTINGS ===== -->
            <Border Grid.Column="2" Style="{StaticResource PanelInset}">
                <StackPanel>
                    <CheckBox x:Name="AlwaysOverlayCheckBox"         Content="Always keep overlay on"  Margin="0,0,0,4"/>
                    <CheckBox x:Name="StartOnSecondMonitorCheckBox"   Content="Open on 2nd monitor"     Margin="0,0,0,4"/>
                    <CheckBox x:Name="EnableCombatLogCheckBox"        Content="Auto-detect NPCs from log" Margin="0,0,0,2"/>
                    <TextBlock x:Name="CombatLogPathText" Text="" Foreground="{StaticResource TextDim}"
                               TextWrapping="Wrap" FontSize="10" Margin="14,0,0,6"/>

                    <Button x:Name="RunSetupButton" Content="⚙ Re-run Setup" Click="RunSetupButton_Click"
                            BorderBrush="{StaticResource Accent}" Margin="0,0,0,4" HorizontalAlignment="Left" Padding="10,5"
                            ToolTip="Re-open the setup wizard — change monitor, log folder"/>
                    <Button x:Name="LaunchOverlayStandardButton" Content="Overlay ▶" Click="ToggleOverlayButton_Click"
                            Margin="0,0,0,4" HorizontalAlignment="Left" Padding="10,5"
                            ToolTip="Show or hide the overlay window"/>
                    <Button x:Name="ReloadNpcDatasetButton" Content="Reload NPC dataset" Click="ReloadNpcDatasetButton_Click"
                            Margin="0,0,0,4" HorizontalAlignment="Left" Padding="10,5"/>
                    <Button x:Name="OpenLogFolderButton"    Content="Open log folder"    Click="OpenLogFolderButton_Click"
                            Margin="0,0,0,4" HorizontalAlignment="Left" Padding="10,5"/>

                    <Border Height="1" Background="{StaticResource PanelBorder}" Opacity="0.7" Margin="0,6,0,6"/>
                    <TextBlock x:Name="LastRunTextBlock" Text="Last run: (none yet)"
                               Foreground="{StaticResource TextDim}" TextWrapping="Wrap" FontSize="11"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Border>


        <!-- ================= BOTTOM: TABS ================= -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TabControl Grid.Row="0" Background="{StaticResource AppBg}" BorderBrush="{StaticResource PanelBorder}">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                                <Setter Property="Background" Value="{StaticResource BtnBg}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
                                <Setter Property="Padding" Value="12,5"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border x:Name="TabBorder"
                                                    Background="{StaticResource BtnBg}"
                                                    BorderBrush="{StaticResource PanelBorder}"
                                                    BorderThickness="1,1,1,0"
                                                    CornerRadius="6,6,0,0"
                                                    Padding="12,5"
                                                    Margin="0,0,2,0">
                                                <ContentPresenter ContentSource="Header"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource PanelGlass}"/>
                                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource BtnHover}"/>
                                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>

                        <!-- ===== NPC LIBRARY TAB ===== -->
                        <TabItem Header="NPC Library">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource PanelInset}" Margin="0,6,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Family:" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource DimText}"/>
                                        <ComboBox x:Name="NpcGroupComboBox" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="NpcGroupComboBox_SelectionChanged"/>
                                        <TextBlock Grid.Column="3" Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource DimText}"/>
                                        <TextBox x:Name="NpcFilterTextBox" Grid.Column="4" VerticalAlignment="Center" TextChanged="NpcFilterTextBox_TextChanged"/>
                                        <TextBlock x:Name="NpcMatchesTextBlock" Grid.Column="5" Text="0 matches" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="10,0,0,0"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource PanelInset}" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Show All" Click="NpcShowAllButton_Click"/>
                                        <Button Grid.Column="1" Content="Show Detected" Click="NpcShowDetectedButton_Click"/>
                                        <Button x:Name="NpcClearDetectedButton" Grid.Column="2" Content="Clear Detected" Click="NpcClearDetectedButton_Click" Visibility="Collapsed"/>
                                        <Button Grid.Column="3" Content="Clear Search" Click="NpcClearSearchButton_Click"/>
                                        <TextBlock x:Name="NpcOverviewStatusTextBlock" Grid.Column="4" Text="" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" MinWidth="280"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="3*" MinWidth="320"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Detail panel on LEFT -->
                                    <Border Grid.Column="0" Style="{StaticResource PanelInset}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel>
                                                <TextBlock x:Name="NpcDetailName" Text="(none)" FontSize="13" FontWeight="Bold" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="NpcDetailLine" Text="" FontSize="10" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                <Border Style="{StaticResource DividerLine}" Margin="0,2,0,8"/>
                                                <TextBlock Text="Notes" FontWeight="Bold" FontSize="11" Margin="0,0,0,3"/>
                                                <TextBlock x:Name="NpcDetailNotes" Text="" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                <TextBlock Text="Quick handle" FontWeight="Bold" FontSize="11" Margin="0,0,0,3"/>
                                                <TextBlock x:Name="NpcDetailHandle" Text="" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                <TextBlock Text="Abyss Dataset" FontWeight="Bold" FontSize="11" Margin="0,12,0,3"/>
                                                <TextBox x:Name="NpcDatasetText"
                                                         TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True"
                                                         VerticalScrollBarVisibility="Auto" Height="140"
                                                         Background="#0F1115" Foreground="#D7D7D7"
                                                         BorderBrush="#262B33" BorderThickness="1"
                                                         Padding="8" FontFamily="Consolas" FontSize="11"/>
                                                <TextBlock Text="Tags" FontWeight="Bold" FontSize="11" Margin="0,8,0,3"/>
                                                <ItemsControl x:Name="NpcDetailTags">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#1E2732" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="8,3" Margin="0,0,6,6">
                                                                <TextBlock Text="{Binding}" FontSize="10" Foreground="{StaticResource TextDim}"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>

                                    <GridSplitter Grid.Column="1" Width="6"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                  Background="{StaticResource PanelBorder}"
                                                  ShowsPreview="True" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

                                    <!-- NPC list on RIGHT -->
                                    <ListView x:Name="NpcListView" Grid.Column="2"
                                              ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              SelectionChanged="NpcListView_SelectionChanged">
                                        <ListView.Resources>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                <Setter Property="TextWrapping" Value="NoWrap"/>
                                            </Style>
                                        </ListView.Resources>
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Name" Width="190">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Family" Width="125">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Family}" ToolTip="{Binding Family}" TextTrimming="CharacterEllipsis"/>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Class" Width="90">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Class}" ToolTip="{Binding Class}" TextTrimming="CharacterEllipsis"/>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Threat" Width="65">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Threat}" ToolTip="{Binding Threat}" TextTrimming="CharacterEllipsis"/>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Kill" Width="120">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding KillPriority}" ToolTip="{Binding KillPriority}" TextTrimming="CharacterEllipsis"/>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- ===== HISTORY TAB ===== -->
                        <TabItem Header="History">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0">
                                    <DockPanel Margin="0,6,0,6">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                            <Button Content="Clear" Width="80" Click="HistoryClearButton_Click" BorderBrush="{StaticResource Danger}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                            <TextBlock x:Name="HistoryCountTextBlock" Text="Runs: 0" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextDim}"/>
                                            <TextBlock x:Name="HistoryPreviewCountTextBlock" Text="(last 0)" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextDim}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock x:Name="HistoryStatusTextBlock" Text="" Foreground="{StaticResource TextDim}" Margin="0,0,0,6"/>
                                </StackPanel>
                                <ListView Grid.Row="1" x:Name="HistoryListView"
                                          ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListView.Resources>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="TextWrapping" Value="NoWrap"/>
                                            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                        </Style>
                                    </ListView.Resources>
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Time" Width="150" DisplayMemberBinding="{Binding TimestampDisplay}"/>
                                            <GridViewColumn Header="Tier" Width="80" DisplayMemberBinding="{Binding Tier}"/>
                                            <GridViewColumn Header="Weather" Width="80" DisplayMemberBinding="{Binding Weather}"/>
                                            <GridViewColumn Header="Rooms" Width="55" DisplayMemberBinding="{Binding RoomsDisplay}"/>
                                            <GridViewColumn Header="Elapsed" Width="60" DisplayMemberBinding="{Binding Elapsed}"/>
                                            <GridViewColumn Header="Remain" Width="60" DisplayMemberBinding="{Binding Remaining}"/>
                                            <GridViewColumn Header="Splits" Width="280" DisplayMemberBinding="{Binding SplitsDisplay}"/>
                                            <GridViewColumn Header="Loot (M)" Width="90" DisplayMemberBinding="{Binding LootDisplay}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <ListView x:Name="HistoryPreviewListView" Visibility="Collapsed"/>
                            </Grid>
                        </TabItem>

                        <!-- ===== STATS TAB ===== -->
                        <TabItem Header="Stats">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,6,0,0">
                                    <WrapPanel Margin="0,0,0,10">
                                        <StackPanel Margin="0,0,22,0">
                                            <TextBlock Text="Total runs:" Foreground="{StaticResource TextDim}"/>
                                            <TextBlock x:Name="StatsTotalRunsText" Text="0" FontWeight="Bold"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,22,0">
                                            <TextBlock Text="Total time:" Foreground="{StaticResource TextDim}"/>
                                            <TextBlock x:Name="StatsTotalTimeText" Text="00:00:00" FontWeight="Bold"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,22,0">
                                            <TextBlock Text="Average run:" Foreground="{StaticResource TextDim}"/>
                                            <TextBlock x:Name="StatsAvgRunText" Text="--:--" FontWeight="Bold"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,22,0">
                                            <TextBlock Text="Best (time left):" Foreground="{StaticResource TextDim}"/>
                                            <TextBlock x:Name="StatsBestRunText" Text="--:--" FontWeight="Bold"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,22,0">
                                            <TextBlock Text="Total loot (M):" Foreground="{StaticResource TextDim}"/>
                                            <TextBlock x:Name="StatsTotalLootText" Text="0" FontWeight="Bold"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,22,0">
                                            <TextBlock Text="Avg loot/run (M):" Foreground="{StaticResource TextDim}"/>
                                            <TextBlock x:Name="StatsAvgLootText" Text="--" FontWeight="Bold"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,22,0">
                                            <TextBlock Text="ISK/hour (M):" Foreground="{StaticResource TextDim}"/>
                                            <TextBlock x:Name="StatsIskHourText" Text="--" FontWeight="Bold" Foreground="{StaticResource Success}"/>
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock Text="Runs by Tier" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <ListView x:Name="StatsByTierListView" Height="170" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Tier" Width="140" DisplayMemberBinding="{Binding Key}"/>
                                                <GridViewColumn Header="Count" Width="70" DisplayMemberBinding="{Binding Count}"/>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                    <TextBlock Text="Runs by Weather" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <ListView x:Name="StatsByWeatherListView" Height="170" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Weather" Width="140" DisplayMemberBinding="{Binding Key}"/>
                                                <GridViewColumn Header="Count" Width="70" DisplayMemberBinding="{Binding Count}"/>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                    <TextBlock Text="Tier + Weather" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <ListView x:Name="StatsByTierWeatherListView" Height="170" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Tier" Width="110" DisplayMemberBinding="{Binding Tier}"/>
                                                <GridViewColumn Header="Weather" Width="110" DisplayMemberBinding="{Binding Weather}"/>
                                                <GridViewColumn Header="Count" Width="70" DisplayMemberBinding="{Binding Count}"/>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="About">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="12,12,12,12">

                                    <TextBlock Text="EVE Abyss Companion" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock Text="v1.0.0 Beta — Built by JakkelsZA" Foreground="{StaticResource TextDim}" Margin="0,0,0,12"/>

                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                                               Text="A free companion app for tracking Abyssal Deadspace runs. No memory reading. No game hooks. Just a clean tool that sits alongside EVE and does what it says."/>

                                    <TextBlock Text="Built for capsuleers, by a capsuleer." FontStyle="Italic" Foreground="{StaticResource TextDim}" Margin="0,0,0,20"/>

                                    <TextBlock Text="Support the Project" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}" Margin="0,0,0,12"
                                               Text="The app is free and always will be. If it saves you ISK or time and you want to say thanks, any support is genuinely appreciated."/>

                                    <Border Style="{StaticResource PanelInset}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="Ko-fi" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <TextBlock Text="ko-fi.com/jakkelsza" Foreground="{StaticResource Accent}" Cursor="Hand"
                                                       MouseLeftButtonUp="KofiLink_Click" TextDecorations="Underline"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource PanelInset}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="PayPal" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <TextBlock Text="paypal.me/JakkelsZA" Foreground="{StaticResource Accent}" Cursor="Hand"
                                                       MouseLeftButtonUp="PaypalLink_Click" TextDecorations="Underline"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource PanelInset}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="Bitcoin" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <TextBlock Text="35U3rbr7XWAsi55KqUJDpRKoKB8PistGZv" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" FontFamily="Consolas"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource PanelInset}" Margin="0,0,0,20">
                                        <StackPanel>
                                            <TextBlock Text="GitHub" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <TextBlock Text="github.com/JakkelsZA" Foreground="{StaticResource Accent}" Cursor="Hand"
                                                       MouseLeftButtonUp="GithubLink_Click" TextDecorations="Underline"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}" FontSize="10"
                                               Text="EVE Online and all associated assets are property of Fenris Creations (formerly CCP Games). This app is not affiliated with or endorsed by Fenris Creations."/>

                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
